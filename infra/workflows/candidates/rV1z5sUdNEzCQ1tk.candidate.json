    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json || {};\nconst headers = raw.headers || {};\nconst auth = headers.authorization || headers.Authorization || '';\nconst expected = $env.N8N_CALENDAR_TOKEN;\n\nif (!expected || auth !== `Bearer ${expected}`) {\n  throw new Error('AUTH_FAILED: Bearer token required for raw cancel writer');\n}\n\nconst payload = raw.body || raw;\nconst calendarEventId = String(payload.calendarEventId || payload.event_id || '').trim();\nconst zoomMeetingId = String(payload.zoomMeetingId || payload.zoom_id || '').trim();\nconst calendarId = payload.calendarId || 'ocompudoc@gmail.com';\n\nif (!calendarEventId && !zoomMeetingId) {\n  throw new Error('Missing calendarEventId/zoomMeetingId');\n}\n\nreturn [{ json: { calendarEventId, zoomMeetingId, calendarId } }];"
      },
