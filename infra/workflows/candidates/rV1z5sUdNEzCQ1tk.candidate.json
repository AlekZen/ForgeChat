          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const norm = $('Normalize Cancel').first().json;\nconst getResp = $input.first() ? $input.first().json : {};\nconst statusCode = Number(getResp.statusCode || (getResp.status === 404 || getResp.status === 410 ? getResp.status : 0));\nconst body = getResp.body || getResp;\n\n// Google Calendar returns 404/410 or status 'cancelled' once deleted\nconst isAbsentInCalendar = !norm.calendarEventId || statusCode === 404 || statusCode === 410 || body.status === 'cancelled' || body.error?.code === 404 || body.error?.code === 410;\nconst verified = Boolean(isAbsentInCalendar);\n\nreturn [{\n  json: {\n    ok: verified,\n    verified,\n    status: verified ? 'cancelled' : 'uncertain',\n    state: verified ? 'cancelada' : 'incierta',\n    calendarEventId: norm.calendarEventId,\n    zoomMeetingId: norm.zoomMeetingId,\n    provider_absence_verified: isAbsentInCalendar,\n    get_http_status: statusCode\n  }\n}];"
      },
